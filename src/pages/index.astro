---
import TrekSystem from "../components/trek/TrekSystem";
import "../styles/trek-sys.css";
---

<!doctype html>
<html lang="es">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    /><meta name="theme-color" content="#050708" /><title>TREK//SYS</title><link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    /><link
      href="https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700&family=Share+Tech+Mono&family=Tektur:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    /><meta
      name="description"
      content="Checklist personal de senderismo para preparar y controlar tu equipo."
    /><meta name="application-name" content="TREK//SYS" /><meta
      name="apple-mobile-web-app-capable"
      content="yes"
    /><meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    /><meta name="apple-mobile-web-app-title" content="TREK//SYS" /><link
      rel="manifest"
      href="/manifest.webmanifest"
    /><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" /><link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    /><link
      rel="icon"
      href="/favicon.ico"
    /></head
  ><body
    ><TrekSystem client:load /><script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js').catch(() => {
            // La app sigue funcionando en navegadores sin registro de PWA.
          })
        })
      }
    </script></body
  >
</html>
